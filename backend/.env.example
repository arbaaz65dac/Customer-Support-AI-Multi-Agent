APP_NAME=Customer Support AI Assistant
APP_VERSION=0.1.0
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=customer_support_ai
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password

GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=replace-with-your-google-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_MAX_DISTANCE=1.5

# Required only when running seed_data.py; use unique local demo passwords.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Replace with a long, random secret before starting the API.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-process fixed-window limits; use shared storage for multiple API workers.
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
